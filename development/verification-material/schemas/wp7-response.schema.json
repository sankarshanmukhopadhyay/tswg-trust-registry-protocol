{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trqp/wp7-response.schema.json",
  "title": "Downstream candidate TRQP evidence-aware response",
  "type": "object",
  "required": ["decision", "reason", "time_evaluated", "evidence"],
  "properties": {
    "authorized": { "type": "boolean" },
    "recognized": { "type": "boolean" },
    "decision": { "enum": ["positive", "authoritative-negative", "indeterminate", "not-applicable"] },
    "reason": {
      "enum": ["established", "not-listed", "revoked", "expired", "source-unavailable", "source-non-authoritative", "evidence-incomplete", "evidence-stale", "evidence-conflicting", "evidence-unknown", "historical-evidence-incomplete", "unsupported-critical-context", "required-profile-unsupported", "profile-contract-unsatisfied", "outside-scope"]
    },
    "evidence_state": { "enum": ["sufficient", "incomplete", "stale", "unavailable", "non-authoritative", "conflicting", "unknown"] },
    "time_requested": { "type": "string", "format": "date-time" },
    "time_evaluated": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "authoritative", "complete_for_scope"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "authoritative": { "type": "boolean" },
          "complete_for_scope": { "type": "boolean" },
          "scope": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" },
          "effective_from": { "type": "string", "format": "date-time" },
          "effective_until": { "type": "string", "format": "date-time" },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "positive" } }, "required": ["decision"] },
      "then": {
        "properties": { "reason": { "const": "established" }, "evidence_state": { "const": "sufficient" } },
        "anyOf": [
          { "properties": { "authorized": { "const": true } }, "required": ["authorized"] },
          { "properties": { "recognized": { "const": true } }, "required": ["recognized"] }
        ]
      }
    },
    {
      "if": { "properties": { "decision": { "const": "authoritative-negative" } }, "required": ["decision"] },
      "then": {
        "properties": { "reason": { "enum": ["not-listed", "revoked", "expired"] }, "evidence_state": { "const": "sufficient" } },
        "not": { "anyOf": [
          { "properties": { "authorized": { "const": true } }, "required": ["authorized"] },
          { "properties": { "recognized": { "const": true } }, "required": ["recognized"] }
        ] }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "indeterminate" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "reason": { "enum": ["source-unavailable", "source-non-authoritative", "evidence-incomplete", "evidence-stale", "evidence-conflicting", "evidence-unknown", "historical-evidence-incomplete", "unsupported-critical-context", "required-profile-unsupported", "profile-contract-unsatisfied"] },
          "evidence_state": { "enum": ["incomplete", "stale", "unavailable", "non-authoritative", "conflicting", "unknown"] }
        },
        "not": { "anyOf": [
          { "properties": { "authorized": { "const": true } }, "required": ["authorized"] },
          { "properties": { "recognized": { "const": true } }, "required": ["recognized"] }
        ] }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "not-applicable" } }, "required": ["decision"] },
      "then": {
        "properties": { "reason": { "const": "outside-scope" }, "evidence_state": { "const": "sufficient" } },
        "not": { "anyOf": [
          { "properties": { "authorized": { "const": true } }, "required": ["authorized"] },
          { "properties": { "recognized": { "const": true } }, "required": ["recognized"] }
        ] }
      }
    },
    {
      "if": { "properties": { "reason": { "const": "evidence-incomplete" } }, "required": ["reason", "evidence_state"] },
      "then": { "properties": { "evidence_state": { "const": "incomplete" } } }
    },
    {
      "if": { "properties": { "reason": { "const": "evidence-stale" } }, "required": ["reason", "evidence_state"] },
      "then": { "properties": { "evidence_state": { "const": "stale" } } }
    },
    {
      "if": { "properties": { "reason": { "const": "source-unavailable" } }, "required": ["reason", "evidence_state"] },
      "then": { "properties": { "evidence_state": { "const": "unavailable" } } }
    },
    {
      "if": { "properties": { "reason": { "const": "source-non-authoritative" } }, "required": ["reason", "evidence_state"] },
      "then": { "properties": { "evidence_state": { "const": "non-authoritative" } } }
    },
    {
      "if": { "properties": { "reason": { "const": "evidence-conflicting" } }, "required": ["reason", "evidence_state"] },
      "then": { "properties": { "evidence_state": { "const": "conflicting" } } }
    },
    {
      "if": { "properties": { "reason": { "const": "evidence-unknown" } }, "required": ["reason", "evidence_state"] },
      "then": { "properties": { "evidence_state": { "const": "unknown" } } }
    }
  ],
  "additionalProperties": false
}
