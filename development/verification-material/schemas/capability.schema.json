{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trqp:candidate:capability:v1",
  "title": "TRQP v3 candidate capability document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "service_id",
    "publisher_id",
    "trqp_versions",
    "processing_profiles",
    "issued_at",
    "expires_at",
    "endpoints"
  ],
  "properties": {
    "type": {
      "const": "trqp-capability-v1"
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "publisher_id": {
      "type": "string",
      "minLength": 1
    },
    "trqp_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "processing_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "processing_semantics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_context": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trqp_versions": {
            "contains": {
              "const": "3.0-candidate"
            }
          }
        },
        "required": [
          "trqp_versions"
        ]
      },
      "then": {
        "required": [
          "processing_semantics",
          "supported_context"
        ],
        "properties": {
          "processing_semantics": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
